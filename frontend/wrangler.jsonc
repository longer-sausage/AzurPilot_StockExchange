{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "azurpilot-stockexchange",
  "compatibility_date": "2026-11-03",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
  "routes": [
    { "pattern": "stock.azurpilot.com/*", "zone_name": "azurpilot.com" },
  ],
}
