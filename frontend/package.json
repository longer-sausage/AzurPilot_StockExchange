{
  "name": "mingmiao-stock-exchange",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 5178",
    "dev:test": "node scripts/dev-test.mjs",
    "build": "next build && node scripts/export.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "test:e2e": "playwright test",
    "test:ui": "playwright test --config playwright.ui.config.ts",
    "preview:demo": "node scripts/preview-demo.mjs",
    "deploy": "wrangler deploy",
    "test:edge": "node scripts/check-edge.mjs",
    "check:worker": "wrangler deploy --dry-run",
    "format": "prettier --write src app scripts *.ts *.mjs"
  },
  "dependencies": {
    "@cloudflare/kumo": "2.17.0",
    "@phosphor-icons/react": "2.1.10",
    "echarts": "6.1.0",
    "next": "16.4.4",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.4",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.4",
    "typescript": "7.0.2",
    "wrangler": "4.156.2"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
