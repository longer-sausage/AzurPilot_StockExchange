# 此文件只有公开配置。复制为 .env 后填写私密值；不要提交 .env。
EXCHANGE_DOMAIN=stock.nanoda.work
LISTEN_ADDR=127.0.0.1:8080
DATABASE_PATH=data/exchange.db
FRONTEND_DIR=frontend/dist
TURNSTILE_SECRET_KEY=replace-with-cloudflare-secret
# 同时填写 AzurPilot 页面实际 hostname，并在 CF Turnstile 控制台允许这些域名。
TURNSTILE_HOSTNAMES=stock.nanoda.work,localhost,127.0.0.1
ADMIN_PASSWORD=replace-with-a-long-random-password
# 用于签发短时登录凭据，至少 32 字符。更换此值会使所有会话失效。
SESSION_SECRET=replace-with-at-least-32-random-characters
# 必填：外部提供的 TLS 证书和无密码私钥绝对路径，不会自动签发或续期。
# 使用 Cloudflare Origin 证书时须启用 Cloudflare 代理和 Full (strict)。
TLS_CERT_FILE=/etc/ssl/mmex/fullchain.pem
TLS_KEY_FILE=/etc/ssl/mmex/privkey.pem
# 浏览器直连 Go API 的允许来源。原生玩家页面通过 AzurPilot 后端代理。
ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*
# 仅限本机开发的独立模拟模式；生产部署脚本会拒绝启用。
MOCK_MODE=false
