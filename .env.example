EXCHANGE_DOMAIN=stock.azurpilot.com
# 既有 PostgreSQL 容器的 Docker 网络，不由此 compose 创建/销毁数据库。
POSTGRES_NETWORK=replace-with-existing-postgres-network
DATABASE_URL=postgres://mingmiao_exchange:replace-with-random-database-password@postgres:5432/mingmiao_exchange?sslmode=disable
ADMIN_PASSWORD=replace-with-random-admin-password-at-least-16-characters
BOT_API_TOKEN=replace-with-random-token-at-least-48-characters
SESSION_SECRET=replace-with-random-secret-at-least-48-characters
COOKIE_SECURE=true
# 使用同域 nginx 时无需 CORS。开发环境可填 http://127.0.0.1:5178。
ALLOWED_ORIGINS=
